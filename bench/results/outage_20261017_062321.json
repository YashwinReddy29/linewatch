{
  "benchmark": "outage_drill",
  "machine": {
    "cpu": "Intel(R) Core(TM) Ultra 7 155U",
    "cores": 4,
    "python": "3.12.3",
    "os": "Linux-6.6.87.2-microsoft-standard-WSL2-x86_64-with-glibc2.39"
  },
  "settings": {
    "web": "http://localhost:3200",
    "incidents": 50,
    "down_seconds": 20.0,
    "stop_cmd": "docker compose -p linewatch-bench stop web",
    "start_cmd": "docker compose -p linewatch-bench start web"
  },
  "incidents_written_while_down": 50,
  "retries_during_outage": 8,
  "web_ready_after_restart_seconds": 1.0,
  "outbox_empty_after_restart_seconds": 5.4,
  "left_in_outbox": 0,
  "dead_letters": 0,
  "incidents_stored": 50,
  "incidents_lost": 0,
  "rows_per_incident_max": 1
}
