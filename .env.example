# Copy to .env and fill in. Never commit .env.

# Roboflow > Settings > API Keys > Private API Key
ROBOFLOW_API_KEY=

# Inference server (local Docker). Inside docker compose this becomes http://inference:9001
INFERENCE_URL=http://localhost:9001

# Models (Roboflow Universe IDs or aliases).
# Chosen by eval/compare_models.py on our clips: RF-DETR small finds the most people,
# construction-site-safety/27 is the only model that finds vests. Same ID in both = one call.
PERSON_MODEL_ID=rfdetr-small
PPE_MODEL_ID=construction-site-safety/27
PERSON_CLASSES=person
VEST_CLASSES=safety vest,vest
PERSON_CONFIDENCE=0.35
VEST_CONFIDENCE=0.25
VEST_MIN_COVERAGE=0.5

# Video: a file path (looped like a live camera), an rtsp:// URL, or a webcam index
VIDEO_SOURCE=samples/street-crew.mp4
LOOP_VIDEO=true
MAX_WIDTH=1280
# 0 = play files in real time like a camera. N = process every Nth frame once (repeatable eval passes).
FRAME_STRIDE=0

# Incident rule: fire when MIN_VIOLATING_FRAMES of the last WINDOW_FRAMES are violations
WINDOW_FRAMES=6
MIN_VIOLATING_FRAMES=4
STALE_TRACK_SECONDS=10
# At most one incident per tracked person in this many seconds
INCIDENT_COOLDOWN_SECONDS=60
# Merge a re-identified person into their live incident (radius in person-heights, 0 = off)
DEDUPE_RADIUS=1.0
DEDUPE_SECONDS=15

# Tracker (ByteTrack). Lower activation helps when the detector is unsure about small people.
TRACK_ACTIVATION_THRESHOLD=0.2
TRACK_LOST_BUFFER=30
TRACK_MATCH_THRESHOLD=0.8
TRACK_FRAME_RATE=5

# Worker alone: leave WEB_URL empty (zone from ZONE_FILE, incidents to out/incidents).
# With the web app running locally: WEB_URL=http://localhost:3000 (docker compose sets this itself).
WEB_URL=
# Shared secret between worker and web app. Generate one: openssl rand -hex 24
WORKER_TOKEN=change-me-to-a-long-random-string
ZONE_FILE=worker/zone.json

STREAM_PORT=8090
WEB_PORT=3000
DB_PORT=5433
OUT_DIR=out

# Web console
SITE_NAME=Calle 5 roadworks
# Optional: where "Mark as false alarm" sends the clean frame for relabeling.
# Create a free Object Detection project in Roboflow; the slugs are in its URL:
# app.roboflow.com/<ROBOFLOW_WORKSPACE>/<ROBOFLOW_PROJECT>
ROBOFLOW_WORKSPACE=
ROBOFLOW_PROJECT=
